{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://nats.io/schemas/server/monitor/v1/statsz_request.json",
  "title": "io.nats.server.monitor.v1.statsz_request",
  "description": "Request options for statsz monitoring endpoint",
  "type": "object",
  "properties": {
    "cluster": {
      "type": "string",
      "description": "filter by cluster name"
    },
    "domain": {
      "type": "string",
      "description": "filter by JS domain"
    },
    "host": {
      "type": "string",
      "description": "filter by host name"
    },
    "server_name": {
      "type": "string",
      "description": "filter by server name"
    },
    "tags": {
      "type": "array",
      "description": "filter by tags (must match all tags)",
      "items": {
        "type": "string"
      }
    }
  }
}
