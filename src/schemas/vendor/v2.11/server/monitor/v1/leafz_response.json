{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://nats.io/schemas/server/monitor/v1/leafz_response.json",
  "title": "io.nats.server.monitor.v1.leafz_response",
  "description": "Response from leafz monitoring endpoint",
  "type": "object",
  "properties": {
    "leafnodes": {
      "type": "integer"
    },
    "leafs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "account": {
            "type": "string"
          },
          "compression": {
            "type": "string"
          },
          "id": {
            "type": "integer"
          },
          "in_bytes": {
            "type": "integer"
          },
          "in_msgs": {
            "type": "integer"
          },
          "ip": {
            "type": "string"
          },
          "is_spoke": {
            "type": "boolean"
          },
          "name": {
            "type": "string"
          },
          "out_bytes": {
            "type": "integer"
          },
          "out_msgs": {
            "type": "integer"
          },
          "port": {
            "type": "integer"
          },
          "rtt": {
            "type": "string"
          },
          "subscriptions": {
            "type": "integer"
          },
          "subscriptions_list": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "account",
          "id",
          "in_bytes",
          "in_msgs",
          "ip",
          "is_spoke",
          "name",
          "out_bytes",
          "out_msgs",
          "port",
          "subscriptions"
        ]
      }
    },
    "now": {
      "type": "string",
      "format": "date-time"
    },
    "server_id": {
      "type": "string"
    }
  },
  "required": [
    "leafnodes",
    "leafs",
    "now",
    "server_id"
  ]
}
