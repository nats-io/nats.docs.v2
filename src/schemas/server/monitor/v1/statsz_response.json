    },
    "gomaxprocs": {
      "type": "integer"
    },
    "gomemlimit": {
      "type": "integer"
    },
    "jetstream": {
      "type": "object",
      "properties": {
        "config": {
          "type": "object",
          "description": "Config is the active JetStream configuration",
          "properties": {
            "compress_ok": {
              "type": "boolean",
              "description": "CompressOK indicates if compression is supported"
            },
            "domain": {
              "type": "string",
              "description": "Domain is the JetStream domain"
            },
            "max_memory": {
              "type": "integer",
              "description": "MaxMemory is the maximum size of memory type streams"
            },
            "max_storage": {
              "type": "integer",
              "description": "MaxStore is the maximum size of file store type streams"
            },
            "store_dir": {
              "type": "string",
              "description": "StoreDir is where storage files are stored"
            },
            "strict": {
              "type": "boolean",
              "description": "Strict indicates if strict JSON parsing is performed"
            },
            "sync_always": {
              "type": "boolean",
              "description": "SyncAlways indicates flushes are done after every write"
            },
            "sync_interval": {
              "type": "integer",
              "description": "SyncInterval is how frequently we sync to disk in the background by calling fsync",
              "$comment": "nanoseconds depicting a duration in time"
            },
            "unique_tag": {
              "type": "string",
              "description": "UniqueTag is the unique tag assigned to this instance"
            }
          },
          "required": [
            "max_memory",
            "max_storage"
          ]
        },
        "limits": {
          "type": "object",
          "description": "Limits are the configured JetStream limits",
          "properties": {
            "max_ack_pending": {
              "type": "integer",
              "description": "MaxAckPending is the server limit for maximum amount of outstanding Acks"
            },
            "max_batch_inflight_per_stream": {
              "type": "integer",
              "description": "MaxBatchInflightPerStream is the maximum amount of open batches per stream"
            },
            "max_batch_inflight_total": {
              "type": "integer",
              "description": "MaxBatchInflightTotal is the maximum amount of total open batches per server"
            },
            "max_batch_size": {
              "type": "integer",
              "description": "MaxBatchSize is the maximum amount of messages allowed in a batch publish to a Stream"
            },
            "max_batch_timeout": {
              "type": "integer",
              "description": "MaxBatchTimeout is the maximum time to receive the commit message after receiving the first message of a batch",
              "$comment": "nanoseconds depicting a duration in time"
            },
            "max_duplicate_window": {
              "type": "integer",
              "description": "Duplicates is the maximum value for duplicate tracking on Streams",
              "$comment": "nanoseconds depicting a duration in time"
            },
            "max_ha_assets": {
              "type": "integer",
              "description": "MaxHAAssets is the maximum of Streams and Consumers that may have more than 1 replica"
            },
            "max_request_batch": {
              "type": "integer",
              "description": "MaxRequestBatch is the maximum amount of updates that can be sent in a batch"
            }
          }
        },
        "meta": {
          "type": "object",
          "description": "Meta is information about the JetStream metalayer",
          "properties": {
            "cluster_size": {
              "type": "integer",
              "description": "Size is the known size of the cluster"
            },
            "leader": {
              "type": "string",
              "description": "Leader is the server name of the cluster leader"
            },
            "name": {
              "type": "string",
              "description": "Name is the name of the cluster"
            },
            "peer": {
              "type": "string",
              "description": "Peer is unique ID of the leader"
            },
            "pending": {
              "type": "integer",
              "description": "Pending is how many RAFT messages are not yet processed"
            },
            "replicas": {
              "type": "array",
              "description": "Replicas is a list of known peers",
              "items": {
                "type": "object",
                "properties": {
                  "active": {
                    "type": "integer",
                    "description": "Active is the timestamp it was last active",
                    "$comment": "nanoseconds depicting a duration in time"
                  },
                  "cluster": {
                    "type": "string",
                    "description": "For migrations."
                  },
                  "current": {
                    "type": "boolean",
                    "description": "Current indicates if it was seen recently and fully caught up"
                  },
                  "lag": {
                    "type": "integer",
                    "description": "Lag is how many operations behind it is"
                  },
                  "name": {
                    "type": "string",
                    "description": "Name is the unique name for the peer"
                  },
                  "offline": {
                    "type": "boolean",
                    "description": "Offline indicates if it has not been seen recently"
                  },
                  "peer": {
                    "type": "string",
                    "description": "Peer is the unique ID for the peer"
                  }
                },
                "required": [
                  "active",
                  "current",
                  "name",
                  "peer"
                ]
              }
            },
            "snapshot": {
              "type": "object",
              "description": "Snapshot contains meta snapshot statistics",
              "properties": {
                "last_duration": {
                  "type": "integer",
                  "description": "LastDuration is how long the last meta snapshot took",
                  "$comment": "nanoseconds depicting a duration in time"
                },
                "last_time": {
                  "type": "string",
                  "description": "LastTime is when the last meta snapshot was taken",
                  "format": "date-time"
                },
                "pending_entries": {
                  "type": "integer",
                  "description": "PendingEntries is the count of pending entries in the meta layer"
                },
                "pending_size": {
                  "type": "integer",
                  "description": "PendingSize is the size in bytes of pending entries in the meta layer"
                }
              },
              "required": [
                "pending_entries",
                "pending_size"
              ]
            }
          },
          "required": [
            "cluster_size",
            "pending",
            "snapshot"
          ]
        },
        "stats": {
          "type": "object",
          "description": "Stats is the statistics for the JetStream server",
          "properties": {
            "accounts": {
              "type": "integer"
            },
            "api": {
              "type": "object",
              "properties": {
                "errors": {
                  "type": "integer",
                  "description": "Errors is the total API requests that resulted in error responses"
                },
                "inflight": {
                  "type": "integer",
                  "description": "Inflight are the number of API requests currently being served"
                },
                "level": {
                  "type": "integer",
                  "description": "Level is the active API level this server implements"
                },
                "total": {
                  "type": "integer",
                  "description": "Total is the total API requests received since start"
                }
              },
              "required": [
                "errors",
                "level",
                "total"
              ]
            },
            "ha_assets": {
              "type": "integer"
            },
            "memory": {
              "type": "integer"
            },
            "reserved_memory": {
              "type": "integer"
            },
            "reserved_storage": {
              "type": "integer"
            },
            "storage": {
              "type": "integer"
            }
          },
          "required": [
            "accounts",
            "api",
            "ha_assets",
            "memory",
            "reserved_memory",
            "reserved_storage",
            "storage"
          ]
        }
      }
