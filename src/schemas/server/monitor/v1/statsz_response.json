      "type": "object",
      "properties": {
        "clients": {
          "type": "integer",
          "description": "Clients is how many Client connections became stale connections"
        },
        "gateways": {
          "type": "integer",
          "description": "Gateways is how many Gateway connections became stale connections"
        },
        "leafs": {
          "type": "integer",
