    "slow_consumer_stats": {
      "type": "object",
      "properties": {
        "clients": {
          "type": "integer",
          "description": "Clients is how many Clients were slow consumers"
        },
        "gateways": {
          "type": "integer",
          "description": "Gateways is how many Gateways were slow consumers"
        },
        "leafs": {
          "type": "integer",
          "description": "Leafs is how many Leafnodes were slow consumers"
        },
        "routes": {
