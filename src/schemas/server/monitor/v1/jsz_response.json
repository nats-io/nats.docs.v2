{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://nats.io/schemas/server/monitor/v1/jsz_response.json",
  "title": "io.nats.server.monitor.v1.jsz_response",
  "description": "Response from jsz monitoring endpoint",
  "type": "object",
  "properties": {
    "account_details": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "stream_detail": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "cluster": {
                  "type": "object"
                },
                "config": {
                  "type": "object"
                },
                "consumer_detail": {
                  "type": "array",
                  "items": {
                    "type": "object"
                  }
                },
                "consumer_raft_groups": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "name": {
                        "type": "string"
                      },
                      "raft_group": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "name"
                    ]
                  }
                },
                "created": {
                  "type": "string",
                  "format": "date-time"
                },
                "direct_consumer_detail": {
                  "type": "array",
                  "items": {
                    "type": "object"
                  }
                },
                "mirror": {
                  "type": "object"
                },
                "name": {
                  "type": "string"
                },
                "sources": {
                  "type": "array",
                  "items": {
                    "type": "object"
                  }
                },
                "state": {
                  "type": "object"
                },
                "stream_raft_group": {
                  "type": "string"
                }
              },
              "required": [
                "created",
                "name"
              ]
            }
          }
        },
        "required": [
          "id",
          "name"
        ]
      }
    },
    "bytes": {
      "type": "integer"
    },
    "config": {
      "type": "object"
    },
    "consumers": {
      "type": "integer"
    },
    "consumers_leader": {
      "type": "integer"
    },
    "disabled": {
      "type": "boolean"
    },
    "limits": {
      "type": "object"
    },
    "messages": {
      "type": "integer"
    },
    "meta_cluster": {
      "type": "object",
      "properties": {
        "cluster_size": {
          "type": "integer",
          "description": "Size is the known size of the cluster"
        },
        "leader": {
          "type": "string",
          "description": "Leader is the server name of the cluster leader"
        },
        "name": {
          "type": "string",
          "description": "Name is the name of the cluster"
        },
        "peer": {
          "type": "string",
          "description": "Peer is unique ID of the leader"
        },
        "pending": {
          "type": "integer",
          "description": "Pending is how many RAFT messages are not yet processed"
        },
        "replicas": {
          "type": "array",
          "description": "Replicas is a list of known peers",
          "items": {
            "type": "object"
          }
        },
        "snapshot": {
          "type": "object",
          "description": "Snapshot contains meta snapshot statistics",
          "properties": {
            "last_duration": {
              "type": "integer",
              "description": "LastDuration is how long the last meta snapshot took",
              "$comment": "nanoseconds depicting a duration in time"
            },
            "last_time": {
              "type": "string",
              "description": "LastTime is when the last meta snapshot was taken",
              "format": "date-time"
            },
            "pending_entries": {
              "type": "integer",
              "description": "PendingEntries is the count of pending entries in the meta layer"
            },
            "pending_size": {
              "type": "integer",
              "description": "PendingSize is the size in bytes of pending entries in the meta layer"
            }
          },
          "required": [
            "pending_entries",
            "pending_size"
          ]
        }
      },
      "required": [
        "cluster_size",
        "pending",
        "snapshot"
      ]
    },
    "now": {
      "type": "string",
      "format": "date-time"
    },
    "server_id": {
      "type": "string"
    },
    "streams": {
      "type": "integer"
    },
    "streams_leader": {
      "type": "integer"
    },
    "total": {
      "type": "integer"
    }
  },
  "required": [
    "bytes",
    "consumers",
    "messages",
    "now",
    "server_id",
    "streams",
    "total"
  ]
}
