{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://nats.io/schemas/server/monitor/v1/jsinfo.json",
  "title": "io.nats.server.monitor.v1.jsinfo",
  "description": "Response from jsz monitoring endpoint",
  "type": "object",
  "properties": {
    "account_details": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "stream_detail": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "cluster": {
                  "type": "object"
                },
                "config": {
                  "type": "object"
                },
                "consumer_detail": {
                  "type": "array",
                  "items": {
                    "type": "object"
                  }
                },
                "consumer_raft_groups": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "name": {
                        "type": "string"
                      },
                      "raft_group": {
                        "type": "string"
                      }
                    }
                  }
                },
                "created": {
                  "type": "string",
                  "format": "date-time"
                },
                "direct_consumer_detail": {
                  "type": "array",
                  "items": {
                    "type": "object"
                  }
                },
                "mirror": {
                  "type": "object"
                },
                "name": {
                  "type": "string"
                },
                "sources": {
                  "type": "array",
                  "items": {
                    "type": "object"
                  }
                },
                "state": {
                  "type": "object"
                },
                "stream_raft_group": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "bytes": {
      "type": "integer"
    },
    "config": {
      "type": "object"
    },
    "consumers": {
      "type": "integer"
    },
    "consumers_leader": {
      "type": "integer"
    },
    "disabled": {
      "type": "boolean"
    },
    "limits": {
      "type": "object"
    },
    "messages": {
      "type": "integer"
    },
    "meta_cluster": {
      "type": "object",
      "properties": {
        "cluster_size": {
          "type": "integer"
        },
        "leader": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "peer": {
          "type": "string"
        },
        "pending": {
          "type": "integer"
        },
        "replicas": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "snapshot": {
          "type": "object",
          "properties": {
            "last_duration": {
              "type": "object"
            },
            "last_time": {
              "type": "string",
              "format": "date-time"
            },
            "pending_entries": {
              "type": "integer"
            },
            "pending_size": {
              "type": "integer"
            }
          }
        }
      }
    },
    "now": {
      "type": "string",
      "format": "date-time"
    },
    "server_id": {
      "type": "string"
    },
    "streams": {
      "type": "integer"
    },
    "streams_leader": {
      "type": "integer"
    },
    "total": {
      "type": "integer"
    }
  }
}