{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://nats.io/schemas/server/monitor/v1/leafz.json",
  "title": "io.nats.server.monitor.v1.leafz",
  "description": "Response from leafz monitoring endpoint",
  "type": "object",
  "properties": {
    "leafnodes": {
      "type": "integer"
    },
    "leafs": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "now": {
      "type": "string",
      "format": "date-time"
    },
    "server_id": {
      "type": "string"
    }
  }
}