{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://nats.io/schemas/server/monitor/v1/leafz.json",
  "title": "io.nats.server.monitor.v1.leafz",
  "description": "Response from leafz monitoring endpoint",
  "type": "object",
  "properties": {
    "leafnodes": {
      "type": "integer"
    },
    "leafs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "account": {
            "type": "string"
          },
          "compression": {
            "type": "string"
          },
          "id": {
            "type": "integer"
          },
          "in_bytes": {
            "type": "integer"
          },
          "in_msgs": {
            "type": "integer"
          },
          "ip": {
            "type": "string"
          },
          "is_isolated": {
            "type": "boolean"
          },
          "is_spoke": {
            "type": "boolean"
          },
          "name": {
            "type": "string"
          },
          "out_bytes": {
            "type": "integer"
          },
          "out_msgs": {
            "type": "integer"
          },
          "port": {
            "type": "integer"
          },
          "proxy": {
            "type": "object",
            "properties": {
              "key": {
                "type": "string"
              }
            }
          },
          "rtt": {
            "type": "string"
          },
          "subscriptions": {
            "type": "integer"
          },
          "subscriptions_list": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "now": {
      "type": "string",
      "format": "date-time"
    },
    "server_id": {
      "type": "string"
    }
  }
}